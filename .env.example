# Copy to .env and change the secrets. Never commit .env.
NODE_ENV=development
PORT=3000

# Local Postgres from docker-compose (host port 5433)
DATABASE_URL=postgresql://bookit:bookit@localhost:5433/bookit?schema=public

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-change-me-change-me-change-me
JWT_REFRESH_SECRET=change-me-too-change-me-too-change-me-too

ACCESS_TTL_SECONDS=900
REFRESH_TTL_SECONDS=1209600

# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3001
